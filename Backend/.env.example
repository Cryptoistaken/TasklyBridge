# Copy to .env and fill in. .env is gitignored; .env.example is not.
# Every value here is a placeholder. Never commit a filled-in .env.

# --- Telegram MTProto: the real user account that talks to the provider.
# Create an application at https://my.telegram.org -> API tools.
TG_API_ID=
TG_API_HASH=

# --- The provider bot we bridge to.
TG_TARGET=tasklyBux_bot

# --- Path to the MTProto session. This file is the account; lose it and the
#     account must be logged in again. Store it in Neon, never on a container
#     filesystem, or a redeploy logs every account out.
TG_SESSION=Test/sessions/probe.session

# --- Our own Telegram bot, created via @BotFather.
BOT_TOKEN=

# --- The end user this one MTProto account is bound to. The provider keeps
#     per-chat state, so one account serves exactly one user.
BOUND_USER_ID=

# --- Admin Telegram user ids, comma separated. Price and availability alerts go
#     here and ONLY here: they state the provider's cost, which is our margin.
ADMIN_USER_IDS=

# --- The sellable catalogue lives in task.json, not here.
TASK_JSON=Backend/task.json

# --- Which job the price and availability watcher alerts about.
WATCH_JOB=2FA:Create FB

# --- Price poll interval in seconds. Floor is 300 (5 minutes). Each poll is
#     three automated messages to the provider; polling faster is how an
#     account gets banned.
WATCH_INTERVAL=900

# --- Admin withdrawal destination. The provider pays USDT on BEP-20 (BSC) only
#     and does not validate the address on their side, so ours is checked
#     before any use. There is no confirmation step in the provider flow.
WITHDRAW_WALLET=

# --- Dry run walks the withdrawal flow and sends nothing. Keep true until the
#     admin flow has been proven end to end.
WITHDRAW_DRY_RUN=true

# --- Dashboard access. There is no password: sign-in is the Telegram
#     Login Widget, and only Telegram ids in ADMIN_USER_IDS may enter.
ADMIN_SESSION_SECRET=

# --- Persistence. One Neon database holds the critical data, so deleting the
#     whole Railway project is recoverable.
DATABASE_URL=
NEON_PROJECT_ID=
