TARGET_URL=https://accountscenter.facebook.com/password_and_security/password/change
COOKIE_DOMAIN=.facebook.com
TASK_GROUP=Cookies
TASK_NAME=2FA:Create FB (No mail)
# Phone for the Telegram session file (or pass -p). Digits only, leading + kept.
TG_PHONE=
# Shared current Facebook password for all sheet accounts (or pass -o).
FB_CURRENT_PASSWORD=
# Optional override for the sheet's col-B key (or pass --fa2).
FA2_KEY=
# Telegram API creds live in ../Backend/.env (TG_API_ID, TG_API_HASH, TG_TARGET).
# Only set them here if you run outside the bridge repo.
# TG_API_ID=
# TG_API_HASH=
# TG_TARGET=tasklyBux_bot
